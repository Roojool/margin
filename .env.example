# No key is needed for the current deterministic foundation.
# Revoke any previously shared key. Put a NEW key only in your local .env.
OPENAI_API_KEY=
# Proposed model; account access and live quality are not yet tested.
LLM_MODEL=gpt-6-luna
PORT=4173
# Discovery/repair call limits are planned for later milestones.
MAX_DISCOVERY_CALLS=8
MAX_REPAIR_CALLS=2
# The gateway enforces output and project-budget limits.
MAX_OUTPUT_TOKENS=2000
PROJECT_BUDGET_USD=10
