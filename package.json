{
  "name": "margin",
  "version": "0.1.0",
  "description": "Browser tests, with evidence. A local-first foundation for the FlytBase Tireless Hand hackathon.",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run check && npm test",
    "smoke:api": "node --env-file-if-exists=.env --import tsx src/smoke.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "openai": "^7.23.0",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
